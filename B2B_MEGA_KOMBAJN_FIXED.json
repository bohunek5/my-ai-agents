        "jsCode": "const firms = $input.all().map(item => item.json);\n\nif (firms.length === 0) {\n  return [{ json: { htmlReport: \"<h2>Brak firm spełniających kryteria RODO.</h2>\", count: 0 } }];\n}\n\nlet htmlContent = \"<h2>Cześć Karol! Oto Twoja bezpieczna próbka firm B2B:</h2>\";\nhtmlContent += \"<p>Agenci Antigravity odfiltrowali domeny publiczne (RODO compliance).</p>\";\nhtmlContent += \"<table border='1' cellpadding='10' cellspacing='0' style='border-collapse: collapse; width: 100%;'>\";\nhtmlContent += \"<tr style='background-color: #f2f2f2;'><th>Nazwa Firmy</th><th>E-mail</th><th>Strona WWW</th><th>Info</th></tr>\";\n\nfirms.forEach((f) => {\n  const name = f.title || f.name || \"Firma\";\n  const phone = f.phone || \"brak\";\n  htmlContent += `<tr>\n    <td><b>${name}</b></td>\n    <td><a href='mailto:${f.email}'>${f.email}</a></td>\n    <td><a href='${f.website}'>${f.website || 'Brak'}</a></td>\n    <td>Tel: ${phone}</td>\n  </tr>`;\n});\nhtmlContent += \"</table>\";\n\nreturn [{ json: { htmlReport: htmlContent, count: firms.length } }];"
