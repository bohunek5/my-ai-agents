      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink-black: #010B13;\n    --cyan-glow: #0FFFFF;\n    --neon-violet: #DF00FF;\n  }\n\n  body {\n    background-color: var(--ink-black);\n    color: white;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n  }\n\n  h1, h2, h3, h4, .font-tech {\n    font-family: 'Space+Grotesk', sans-serif;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .neon-border-cyan {\n    border: 1.5px solid var(--cyan-glow);\n    box-shadow: 0 0 12px rgba(15, 255, 255, 0.2), 0 0 36px rgba(15, 255, 255, 0.06);\n  }\n\n  .neon-border-violet {\n    border: 1.5px solid var(--neon-violet);\n    box-shadow: 0 0 12px rgba(223, 0, 255, 0.2), 0 0 36px rgba(223, 0, 255, 0.06);\n  }\n\n  /* Custom Slider Styling */\n  input[type=\"range\"] {\n    -webkit-appearance: none;\n    background: transparent;\n  }\n\n  input[type=\"range\"]::-webkit-slider-runnable-track {\n    height: 4px;\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 2px;\n  }\n\n  input[type=\"range\"]::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    height: 16px;\n    width: 16px;\n    border-radius: 50%;\n    background: white;\n    margin-top: -6px;\n    box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);\n    cursor: pointer;\n  }\n\n  .lenis.lenis-smooth {\n    height: auto;\n  }\n\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n\n  .cursor-glow-area {\n    position: relative;\n    overflow: hidden;\n  }\n\n  .cursor-glow-area::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background: radial-gradient(circle at var(--glow-x, 50%) var(--glow-y, 50%), rgba(15, 255, 255, 0.03) 0%, transparent 60%);\n    z-index: 10;\n  }\n\n\n  .aurora-bg {\n    background: linear-gradient(45deg, #010B13, #021a2b, #010B13);\n    background-size: 400% 400%;\n  }\n</style>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n\n<div id=\"smooth-wrapper\" data-kid=\"2\">\n  <div id=\"smooth-content\" data-kid=\"3\">\n    \n    \n    <header class=\"fixed top-0 left-0 w-full z-[100] px-12 py-8 flex justify-between items-center mix-blend-difference\" data-kid=\"4\">\n      <div class=\"flex items-center gap-3\" data-kid=\"5\">\n        <div class=\"w-10 h-10 bg-[var(--cyan-glow)] rounded-xl flex items-center justify-center shadow-[0_0_25px_rgba(15,255,255,0.4)]\" data-kid=\"6\">\n          <i class=\"ti ti-bolt text-black text-xl\" data-kid=\"7\"></i>\n        </div>\n        <span class=\"font-tech font-bold text-2xl tracking-tighter uppercase\" data-kid=\"8\">Lumina<span class=\"text-[var(--cyan-glow)]\" data-kid=\"9\">Pro</span></span>\n      </div>\n      <nav class=\"hidden md:flex gap-10 text-xs font-bold uppercase tracking-widest text-white/60\" data-kid=\"10\">\n        <a href=\"#workbench\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Configurator</a>\n        <a href=\"#matrix\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Comparison</a>\n        <a href=\"#scenarios\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Applications</a>\n      </nav>\n      <button class=\"px-6 py-2.5 rounded-full border border-white/20 text-[10px] font-bold uppercase tracking-widest hover:bg-white hover:text-black transition-all\" data-kid=\"14\">\n        Pro Account\n      </button>\n    </header>\n\n    \n    <section id=\"workbench\" class=\"min-h-screen flex flex-col lg:flex-row relative cursor-glow-area\" data-kid=\"15\">\n      \n      <div class=\"w-full lg:w-[38%] bg-[#020F1A] border-r border-white/5 p-12 lg:p-20 pt-40 flex flex-col justify-between relative z-20\" data-kid=\"16\">\n        <div class=\"space-y-16 reveal-up\" data-kid=\"17\">\n          <div class=\"space-y-6\" data-kid=\"18\">\n            <h1 class=\"font-tech text-5xl lg:text-6xl font-bold leading-[0.9] tracking-tight\" data-kid=\"19\">\n              Design the <br data-kid=\"20\"><span class=\"text-[var(--cyan-glow)]\" data-kid=\"21\">Invisible.</span>\n            </h1>\n            <p class=\"text-gray-400 max-w-sm leading-relaxed text-sm\" data-kid=\"22\">\n              Professional-grade configuration for linear architectural lighting systems. Real-time photometric calculation and power mapping.\n            </p>\n          </div>\n\n          \n          <div class=\"space-y-6\" data-kid=\"23\">\n            <label class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-gray-500\" data-kid=\"24\">System Architecture</label>\n            <div class=\"flex p-1.5 bg-black/50 rounded-2xl border border-white/5 w-full max-w-sm\" data-kid=\"25\">\n              <button onclick=\"switchVoltage(12)\" class=\"voltage-btn flex-1 py-3 rounded-xl text-xs font-bold transition-all bg-[var(--cyan-glow)] text-black\" data-v=\"12\" data-kid=\"26\">12V</button>\n              <button onclick=\"switchVoltage(24)\" class=\"voltage-btn flex-1 py-3 rounded-xl text-xs font-bold transition-all text-gray-400 hover:text-white\" data-v=\"24\" data-kid=\"27\">24V</button>\n              <button onclick=\"switchVoltage(48)\" class=\"voltage-btn flex-1 py-3 rounded-xl text-xs font-bold transition-all text-gray-400 hover:text-white\" data-v=\"48\" data-kid=\"28\">48V</button>\n            </div>\n          </div>\n\n          \n          <div class=\"space-y-10\" data-kid=\"29\">\n            <div class=\"space-y-4\" data-kid=\"30\">\n              <div class=\"flex justify-between items-end\" data-kid=\"31\">\n                <label class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-gray-500\" data-kid=\"32\">Intensity</label>\n                <div class=\"text-[var(--cyan-glow)] font-tech font-bold text-lg\" data-kid=\"33\"><span id=\"brightness-val\" data-kid=\"34\">850</span> <span class=\"text-[10px] opacity-40\" data-kid=\"35\">LM/FT</span></div>\n              </div>\n              <input type=\"range\" id=\"brightness-slider\" min=\"100\" max=\"1500\" value=\"850\" class=\"w-full\" oninput=\"updateGlow()\" data-kid=\"36\">\n            </div>\n\n            <div class=\"space-y-4\" data-kid=\"37\">\n              <div class=\"flex justify-between items-end\" data-kid=\"38\">\n                <label class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-gray-500\" data-kid=\"39\">Chromaticity</label>\n                <div class=\"text-white font-tech font-bold text-lg\" data-kid=\"40\"><span id=\"temp-val\" data-kid=\"41\">4000</span> <span class=\"text-[10px] opacity-40\" data-kid=\"42\">K</span></div>\n              </div>\n              <div class=\"relative py-2\" data-kid=\"43\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-[#ff9e33] via-[#fff4e6] to-[#99ccff] rounded-full h-1 my-auto opacity-30\" data-kid=\"44\"></div>\n                <input type=\"range\" id=\"temp-slider\" min=\"2000\" max=\"6500\" value=\"4000\" class=\"w-full relative z-10\" oninput=\"updateGlow()\" data-kid=\"45\">\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-2 gap-4 mt-16 reveal-up\" data-kid=\"46\">\n          <div class=\"p-6 rounded-2xl bg-white/5 border border-white/10 group hover:border-[var(--cyan-glow)]/30\" data-kid=\"47\">\n            <div class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1\" data-kid=\"48\">Total Length</div>\n            <div class=\"text-2xl font-tech font-bold text-white\" data-kid=\"49\">12.5m</div>\n          </div>\n          <div class=\"p-6 rounded-2xl bg-white/5 border border-white/10 group hover:border-[var(--neon-violet)]/30 transition-colors\" data-kid=\"50\">\n            <div class=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1\" data-kid=\"51\">Max Power</div>\n            <div class=\"text-2xl font-tech font-bold text-[var(--neon-violet)]\" data-kid=\"52\">187W</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"w-full lg:w-[62%] relative flex items-center justify-center p-12 lg:p-24 overflow-visible aurora-bg\" data-kid=\"53\">\n        \n        <div class=\"absolute inset-0 anime-ambient-pulse opacity-40 pointer-events-none\" data-kid=\"54\">\n          <div id=\"ambient-light\" class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--cyan-glow)] blur-[160px] rounded-full opacity-10\" data-kid=\"55\"></div>\n        </div>\n\n        \n        <div class=\"absolute left-[-200px] right-0 h-[120px] overlap-strip z-30 flex items-center\" data-kid=\"56\">\n          \n          <div id=\"strip-back-glow\" class=\"absolute inset-0 bg-[var(--cyan-glow)]/10 blur-[100px] rounded-full\" data-kid=\"57\"></div>\n          \n          \n          <div class=\"relative w-full h-16 bg-[#111] rounded-full border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] flex items-center px-16\" data-kid=\"58\">\n            \n            <div class=\"absolute inset-0 opacity-10 bg-[repeating-linear-gradient(90deg,transparent,transparent_20px,rgba(245,158,11,0.5)_21px,transparent_24px)] rounded-full\" data-kid=\"59\"></div>\n            \n            \n            <div class=\"flex justify-between w-full relative z-10\" data-kid=\"60\">\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"61\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"62\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"63\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"64\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"65\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"66\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"67\"></div>\n              <div class=\"led-node w-6 h-6 bg-white rounded-xs shadow-[0_0_20px_#fff,0_0_40px_var(--cyan-glow)]\" data-kid=\"68\"></div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute bottom-20 right-20 flex flex-col items-end gap-6 reveal-up\" data-kid=\"69\">\n           <div class=\"flex items-center gap-4 bg-black/40 backdrop-blur-xl px-6 py-3 rounded-2xl border border-white/10 group hover:border-[var(--cyan-glow)] transition-all\" data-kid=\"70\">\n              <div class=\"text-right\" data-kid=\"71\">\n                <div class=\"text-[10px] text-gray-500 font-bold uppercase\" data-kid=\"72\">Color Rendering</div>\n                <div class=\"text-sm font-bold\" data-kid=\"73\">CRI 98+ Ultra</div>\n              </div>\n              <div class=\"w-10 h-10 rounded-lg bg-[var(--cyan-glow)]/10 flex items-center justify-center text-[var(--cyan-glow)]\" data-kid=\"74\">\n                <i class=\"ti ti-macro\" data-kid=\"75\"></i>\n              </div>\n           </div>\n           <div class=\"flex items-center gap-4 bg-black/40 backdrop-blur-xl px-6 py-3 rounded-2xl border border-white/10 group hover:border-[var(--neon-violet)] transition-all\" data-kid=\"76\">\n              <div class=\"text-right\" data-kid=\"77\">\n                <div class=\"text-[10px] text-gray-500 font-bold uppercase\" data-kid=\"78\">Cutting Unit</div>\n                <div class=\"text-sm font-bold\" data-kid=\"79\"><span id=\"cut-val\" data-kid=\"80\">25</span>mm Increments</div>\n              </div>\n              <div class=\"w-10 h-10 rounded-lg bg-[var(--neon-violet)]/10 flex items-center justify-center text-[var(--neon-violet)]\" data-kid=\"81\">\n                <i class=\"ti ti-scissors\" data-kid=\"82\"></i>\n              </div>\n           </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"matrix\" class=\"py-32 px-12 lg:px-24\" data-kid=\"83\">\n      <div class=\"max-w-7xl mx-auto space-y-20\" data-kid=\"84\">\n        <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-8 reveal-up\" data-kid=\"85\">\n          <div class=\"space-y-4\" data-kid=\"86\">\n            <h2 class=\"font-tech text-4xl lg:text-5xl font-bold tracking-tight uppercase\" data-kid=\"87\">Voltage <span class=\"text-[var(--neon-violet)]\" data-kid=\"88\">Matrix.</span></h2>\n            <p class=\"text-gray-400 max-w-xl\" data-kid=\"89\">Optimizing for run length vs complexity. Architecture impacts voltage drop, efficacy, and total cost of ownership.</p>\n          </div>\n          <div class=\"px-8 py-4 bg-white/5 border border-white/10 rounded-2xl flex items-center gap-6\" data-kid=\"90\">\n             <div class=\"flex -space-x-2\" data-kid=\"91\">\n                <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-8 h-8 rounded-full border-2 border-[var(--ink-black)]\" data-kid=\"92\">\n                <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-8 h-8 rounded-full border-2 border-[var(--ink-black)]\" data-kid=\"93\">\n                <img src=\"https://i.pravatar.cc/100?u=3\" class=\"w-8 h-8 rounded-full border-2 border-[var(--ink-black)]\" data-kid=\"94\">\n             </div>\n             <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-500\" data-kid=\"95\">Trusted by 2.4k Engineers</span>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-4 p-4 glass-card rounded-[40px] border-white/5 reveal-up\" data-kid=\"96\">\n          \n          <div class=\"hidden md:flex flex-col justify-between py-24 pl-8\" data-kid=\"97\">\n            <div class=\"h-20 flex items-center text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300\" data-kid=\"98\">Max Run (Single Feed)</div>\n            <div class=\"h-20 flex items-center text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300\" data-kid=\"99\">Cut Precision</div>\n            <div class=\"h-20 flex items-center text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300\" data-kid=\"100\">System Efficiency</div>\n            <div class=\"h-20 flex items-center text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300\" data-kid=\"101\">Driver Topology</div>\n          </div>\n\n          \n          <div id=\"col-12\" class=\"matrix-col bg-black/40 rounded-3xl p-10 border border-white/5 hover:bg-white/5 group\" data-kid=\"102\">\n            <div class=\"text-center pb-10 border-b border-white/10 mb-10\" data-kid=\"103\">\n              <span class=\"text-[10px] font-bold uppercase text-gray-500 block mb-2\" data-kid=\"104\">Residential</span>\n              <h3 class=\"font-tech text-3xl font-bold\" data-kid=\"105\">12V DC</h3>\n            </div>\n            <div class=\"space-y-12 text-center\" data-kid=\"106\">\n              <div class=\"h-12 flex flex-col justify-center\" data-kid=\"107\">\n                <span class=\"text-2xl font-bold\" data-kid=\"108\">5 Meters</span>\n                <span class=\"text-[10px] text-gray-600 font-bold uppercase\" data-kid=\"109\">16.4 ft</span>\n              </div>\n              <div class=\"h-12 flex flex-col justify-center items-center gap-2\" data-kid=\"110\">\n                <span class=\"text-2xl font-bold\" data-kid=\"111\">25mm</span>\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/straight-pipe.svg\" class=\"w-4 h-4 opacity-20 filter invert\" data-kid=\"112\">\n              </div>\n              <div class=\"h-12 flex items-center justify-center font-bold text-gray-400\" data-kid=\"113\">Baseline</div>\n              <div class=\"h-12 flex items-center justify-center text-xs font-bold uppercase tracking-widest text-gray-500\" data-kid=\"114\">Class 2 / PWM</div>\n            </div>\n          </div>\n\n          \n          <div id=\"col-24\" class=\"matrix-col bg-black/40 rounded-3xl p-10 border border-white/5 hover:bg-white/5 group neon-border-cyan\" data-kid=\"115\">\n            <div class=\"text-center pb-10 border-b border-white/10 mb-10\" data-kid=\"116\">\n              <span class=\"text-[10px] font-bold uppercase text-[var(--cyan-glow)] block mb-2\" data-kid=\"117\">Professional</span>\n              <h3 class=\"font-tech text-3xl font-bold text-[var(--cyan-glow)]\" data-kid=\"118\">24V DC</h3>\n            </div>\n            <div class=\"space-y-12 text-center\" data-kid=\"119\">\n              <div class=\"h-12 flex flex-col justify-center\" data-kid=\"120\">\n                <span class=\"text-2xl font-bold\" data-kid=\"121\">10 Meters</span>\n                <span class=\"text-[10px] text-[var(--cyan-glow)]/60 font-bold uppercase\" data-kid=\"122\">32.8 ft</span>\n              </div>\n              <div class=\"h-12 flex flex-col justify-center items-center gap-2\" data-kid=\"123\">\n                <span class=\"text-2xl font-bold\" data-kid=\"124\">50mm</span>\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/straight-pipe.svg\" class=\"w-4 h-4 text-[var(--cyan-glow)] filter drop-shadow-[0_0_5px_var(--cyan-glow)]\" data-kid=\"125\">\n              </div>\n              <div class=\"h-12 flex items-center justify-center font-bold text-[var(--cyan-glow)]\" data-kid=\"126\">+15% lm/W</div>\n              <div class=\"h-12 flex items-center justify-center text-xs font-bold uppercase tracking-widest text-gray-400\" data-kid=\"127\">Constant Voltage</div>\n            </div>\n          </div>\n\n          \n          <div id=\"col-48\" class=\"matrix-col bg-black/40 rounded-3xl p-10 border border-white/5 hover:bg-white/5 group relative overflow-hidden\" data-kid=\"128\">\n            <div class=\"absolute top-0 right-0 bg-[var(--neon-violet)] text-black text-[9px] font-black px-4 py-1.5 rounded-bl-xl uppercase tracking-tighter\" data-kid=\"129\">Architectural Pro</div>\n            <div class=\"text-center pb-10 border-b border-white/10 mb-10\" data-kid=\"130\">\n              <span class=\"text-[10px] font-bold uppercase text-[var(--neon-violet)] block mb-2\" data-kid=\"131\">Long Run</span>\n              <h3 class=\"font-tech text-3xl font-bold text-[var(--neon-violet)]\" data-kid=\"132\">48V DC</h3>\n            </div>\n            <div class=\"space-y-12 text-center\" data-kid=\"133\">\n              <div class=\"h-12 flex flex-col justify-center\" data-kid=\"134\">\n                <span class=\"text-2xl font-bold\" data-kid=\"135\">25 Meters</span>\n                <span class=\"text-[10px] text-[var(--neon-violet)]/60 font-bold uppercase\" data-kid=\"136\">82.0 ft</span>\n              </div>\n              <div class=\"h-12 flex flex-col justify-center items-center gap-2\" data-kid=\"137\">\n                <span class=\"text-2xl font-bold\" data-kid=\"138\">100mm</span>\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/straight-pipe.svg\" class=\"w-4 h-4 text-[var(--neon-violet)] filter drop-shadow-[0_0_5px_var(--neon-violet)]\" data-kid=\"139\">\n              </div>\n              <div class=\"h-12 flex items-center justify-center font-bold text-[var(--neon-violet)]\" data-kid=\"140\">+32% lm/W</div>\n              <div class=\"h-12 flex items-center justify-center text-xs font-bold uppercase tracking-widest text