nk 2-Wire Connector</div>\n                <div class=\"text-[10px] text-gray-500 font-bold uppercase tracking-widest\" data-kid=\"230\">Tool-less • High Temp Nylon</div>\n              </div>\n              <div class=\"text-right\" data-kid=\"231\">\n                <div class=\"text-lg font-tech font-bold text-[var(--cyan-glow)]\" data-kid=\"232\">$4.25</div>\n                <div class=\"text-[9px] text-gray-600 font-black uppercase\" data-kid=\"233\">Qty: 12</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-20 px-12 lg:px-24 border-t border-white/5 mt-32\" data-kid=\"234\">\n      <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12\" data-kid=\"235\">\n        <div class=\"space-y-6 max-w-sm\" data-kid=\"236\">\n          <div class=\"flex items-center gap-3\" data-kid=\"237\">\n            <div class=\"w-8 h-8 bg-[var(--cyan-glow)] rounded-lg flex items-center justify-center\" data-kid=\"238\">\n              <i class=\"ti ti-bolt text-black\" data-kid=\"239\"></i>\n            </div>\n            <span class=\"font-tech font-bold text-xl tracking-tighter uppercase\" data-kid=\"240\">Lumina<span class=\"text-[var(--cyan-glow)]\" data-kid=\"241\">Pro</span></span>\n          </div>\n          <p class=\"text-gray-300 text-xs leading-relaxed uppercase font-medium\" data-kid=\"242\">Precision lighting for the world's most ambitious architectural environments. Designed and engineered in San Francisco.</p>\n        </div>\n        <div class=\"grid grid-cols-2 lg:grid-cols-3 gap-20\" data-kid=\"243\">\n          <div class=\"space-y-6\" data-kid=\"244\">\n            <h4 class=\"text-[10px] font-black uppercase tracking-widest text-white\" data-kid=\"245\">System</h4>\n            <ul class=\"space-y-4 text-xs font-bold text-gray-500\" data-kid=\"246\">\n              <li data-kid=\"247\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"248\">Configurator</a></li>\n              <li data-kid=\"249\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"250\">Voltage Matrix</a></li>\n              <li data-kid=\"251\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"252\">Photometrics</a></li>\n            </ul>\n          </div>\n          <div class=\"space-y-6\" data-kid=\"253\">\n            <h4 class=\"text-[10px] font-black uppercase tracking-widest text-white\" data-kid=\"254\">Resources</h4>\n            <ul class=\"space-y-4 text-xs font-bold text-gray-500\" data-kid=\"255\">\n              <li data-kid=\"256\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"257\">Technical Docs</a></li>\n              <li data-kid=\"258\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"259\">CAD Exports</a></li>\n              <li data-kid=\"260\"><a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"261\">IES Files</a></li>\n            </ul>\n          </div>\n        </div>\n      </div>\n      <div class=\"max-w-7xl mx-auto pt-20 flex justify-between items-center text-[9px] font-black uppercase tracking-widest text-gray-700\" data-kid=\"262\">\n        <span data-kid=\"263\">© 2024 LuminaPro Architectural Systems</span>\n        <div class=\"flex gap-8\" data-kid=\"264\">\n          <a href=\"#\" data-kid=\"265\">Privacy</a>\n          <a href=\"#\" data-kid=\"266\">Terms</a>\n          <a href=\"#\" data-kid=\"267\">Support</a>\n        </div>\n      </div>\n    </footer>\n  </div>\n</div>\n\n\n<div id=\"dock\" class=\"fixed bottom-8 left-1/2 -translate-x-1/2 z-[1000] hidden lg:block opacity-0 translate-y-20\" data-kid=\"268\">\n  <div class=\"flex items-center gap-8 px-10 py-5 bg-black/80 backdrop-blur-3xl border border-white/10 rounded-[32px] shadow-[0_40px_80px_rgba(0,0,0,0.8)]\" data-kid=\"269\">\n    <div class=\"flex items-center gap-4 pr-8 border-r border-white/10\" data-kid=\"270\">\n      <div class=\"w-12 h-12 rounded-2xl bg-[var(--cyan-glow)]/10 flex items-center justify-center\" data-kid=\"271\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/priorblue/battery-100.svg\" class=\"w-6 h-6 filter invert\" style=\"color: var(--cyan-glow);\" data-kid=\"272\">\n      </div>\n      <div data-kid=\"273\">\n        <div class=\"text-[9px] text-gray-500 font-black uppercase tracking-widest\" data-kid=\"274\">System Load</div>\n        <div class=\"text-sm font-tech font-bold text-white\" data-kid=\"275\"><span id=\"dock-load\" data-kid=\"276\">78</span>% Peak</div>\n      </div>\n    </div>\n\n    <div class=\"flex flex-col min-w-[120px]\" data-kid=\"277\">\n      <div class=\"text-[9px] text-gray-500 font-black uppercase tracking-widest\" data-kid=\"278\">Project Total</div>\n      <div class=\"text-3xl font-tech font-bold text-[var(--cyan-glow)] leading-none\" data-kid=\"279\">$<span id=\"dock-price\" data-kid=\"280\">1240</span><span class=\"text-sm opacity-40\" data-kid=\"281\">.50</span></div>\n    </div>\n\n    <button class=\"px-10 py-4 bg-[var(--neon-violet)] text-white text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl shadow-[0_0_40px_rgba(223,0,255,0.4)] hover:scale-105 active:scale-95 transition-all\" data-kid=\"282\">\n      Add to Project\n    </button>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"283\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"284\"></script>\n<script data-kid=\"285\">gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\" data-kid=\"286\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import Snap from \"https://esm.sh/lenis@1/snap\"\n  import { animate, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import { animate as animeAnimate } from 'https://esm.sh/animejs@4'\n\n  // Lenis Smooth Scroll\n  const lenis = new Lenis()\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // Cursor Glow Interaction\n  const heroSection = document.getElementById('workbench');\n  heroSection.addEventListener('mousemove', (e) => {\n    const rect = heroSection.getBoundingClientRect();\n    const x = ((e.clientX - rect.left) / rect.width) * 100;\n    const y = ((e.clientY - rect.top) / rect.height) * 100;\n    heroSection.style.setProperty('--glow-x', `${x}%`);\n    heroSection.style.setProperty('--glow-y', `${y}%`);\n\n    // Tilt Effect for the strip\n    const tiltX = (y - 50) * 0.1;\n    const tiltY = (x - 50) * -0.05;\n    gsap.to('.overlap-strip', {\n      rotateX: tiltX,\n      rotateY: tiltY,\n      duration: 1.5,\n      ease: 'power3.out'\n    });\n  });\n\n  // Entrance Reveals\n  gsap.from('.reveal-up', {\n    scrollTrigger: {\n      trigger: '.reveal-up',\n      start: 'top 90%',\n    },\n    y: 60,\n    autoAlpha: 0,\n    duration: 1.2,\n    ease: 'expo.out',\n    stagger: 0.2\n  });\n\n  // Batch Reveals for Bento and Matrix\n  ScrollTrigger.batch('.matrix-col, #scenarios .grid > div', {\n    onEnter: batch => gsap.from(batch, {\n      y: 40,\n      autoAlpha: 0,\n      stagger: 0.1,\n      duration: 0.8,\n      ease: 'power3.out',\n      overwrite: true\n    }),\n    start: 'top 85%'\n  });\n\n  // Dock Visibility Logic\n  ScrollTrigger.create({\n    trigger: '#workbench',\n    start: 'bottom center',\n    onEnter: () => gsap.to('#dock', { autoAlpha: 1, y: 0, duration: 0.5, ease: 'back.out(1.7)' }),\n    onLeaveBack: () => gsap.to('#dock', { autoAlpha: 0, y: 40, duration: 0.3 })\n  });\n\n  // Ambient Pulse with AnimeJS\n  animeAnimate('#ambient-light', {\n    scale: [1, 1.15],\n    opacity: [0.1, 0.15],\n    duration: 3000,\n    easing: 'easeInOutQuad',\n    direction: 'alternate',\n    loop: true\n  });\n\n  animeAnimate('.led-node', {\n    opacity: [0.8, 1],\n    scale: [1, 1.05],\n    duration: 1500,\n    easing: 'easeInOutSine',\n    delay: (el, i) => i * 100,\n    direction: 'alternate',\n    loop: true\n  });\n\n  // Global Config State\n  window.config = {\n    voltage: 12,\n    brightness: 850,\n    temp: 4000\n  };\n\n  window.switchVoltage = (v) => {\n    window.config.voltage = v;\n    \n    // Update UI Buttons\n    document.querySelectorAll('.voltage-btn').forEach(btn => {\n      btn.classList.remove('bg-[var(--cyan-glow)]', 'text-black');\n      btn.classList.add('text-gray-400');\n      if(parseInt(btn.dataset.v) === v) {\n        btn.classList.add('bg-[var(--cyan-glow)]', 'text-black');\n        btn.classList.remove('text-gray-400');\n      }\n    });\n\n    // Update Highlights in Matrix\n    document.querySelectorAll('.matrix-col').forEach(col => {\n      col.classList.remove('neon-border-cyan', 'neon-border-violet', 'scale-105', 'z-10');\n      col.classList.add('opacity-60');\n    });\n    \n    const activeCol = document.getElementById(`col-${v}`);\n    activeCol.classList.remove('opacity-60');\n    activeCol.classList.add('scale-105', 'z-10');\n    if(v === 24) activeCol.classList.add('neon-border-cyan');\n    if(v === 48) activeCol.classList.add('neon-border-violet');\n\n    // Update Label Values\n    const cutVal = v === 12 ? 25 : (v === 24 ? 50 : 100);\n    document.getElementById('cut-val').textContent = cutVal;\n\n    // Trigger visual change\n    const color = v === 48 ? 'var(--neon-violet)' : 'var(--cyan-glow)';\n    gsap.to(':root', { '--cyan-glow': color, duration: 0.5 });\n    \n    updateGlow();\n  };\n\n  window.updateGlow = () => {\n    const brightness = document.getElementById('brightness-slider').value;\n    const temp = document.getElementById('temp-slider').value;\n    \n    document.getElementById('brightness-val').textContent = brightness;\n    document.getElementById('temp-val').textContent = temp;\n\n    // Calculate light color based on temp\n    // Simplistic temp to color conversion\n    let color;\n    if(temp < 3000) color = '#ffcc99';\n    else if(temp < 4500) color = '#ffffff';\n    else color = '#ccf2ff';\n\n    // Apply to visualization\n    const glowColor = window.config.voltage === 48 ? 'var(--neon-violet)' : 'var(--cyan-glow)';\n    gsap.to('.led-node', {\n      backgroundColor: color,\n      boxShadow: `0 0 ${brightness/20}px ${color}, 0 0 ${brightness/10}px ${glowColor}`,\n      duration: 0.3\n    });\n\n    gsap.to('#strip-back-glow', {\n      opacity: brightness / 1500 * 0.4,\n      scale: 1 + (brightness / 1500 * 0.2),\n      backgroundColor: glowColor,\n      duration: 0.3\n    });\n\n    // Count Up for Dock\n    const totalPrice = Math.round(500 + (brightness * 0.5) + (window.config.voltage * 10));\n    animate(parseInt(document.getElementById('dock-price').textContent), totalPrice, {\n      duration: 0.5,\n      onUpdate: v => document.getElementById('dock-price').textContent = Math.round(v)\n    });\n\n    const load = Math.round((brightness / 1500) * 100);\n    document.getElementById('dock-load').textContent = load;\n    document.getElementById('bom-watts').textContent = (load * 2.5).toFixed(1) + ' W';\n  };\n\n  // Init\n  window.switchVoltage(24);\n</script>\n",
